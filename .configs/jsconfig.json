{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "paths": {
      "hybrids": ["../node_modules/hybrids/types/index.d.ts"],
      "#store/*": ["../src/store/*"],
      "#utils/*": ["../src/utils/*"],
      "#atoms/*": ["../src/components/atoms/*"],
      "#molecules/*": ["../src/components/molecules/*"],
      "#organisms/*": ["../src/components/organisms/*"],
      "#templates/*": ["../src/components/templates/*"],
      "#pages/*": ["../src/pages/*"]
    }
  },
  "include": [
    "../src/**/*.js",
    "../scripts/**/*.js"
  ],
  "exclude": [
    "../node_modules",
    "../node_modules/**",
    "../src/vendor",
    "../src/vendor/**",
    "../**/*.test.js"
  ]
}
